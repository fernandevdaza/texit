{
  "name": "texit",
  "private": true,
  "version": "0.1.0",
  "description": "TexIt — open-source, local-first LaTeX studio: TeX Live in the browser (WebAssembly), serverless end-to-end-encrypted collaboration, AI agents and plugins, for web, macOS, Windows and Linux.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @texit/web dev",
    "build": "pnpm --filter @texit/web build",
    "preview": "pnpm --filter @texit/web preview",
    "desktop:dev": "pnpm --filter @texit/desktop dev",
    "desktop:build": "pnpm --filter @texit/desktop build",
    "desktop:dist": "pnpm --filter @texit/desktop dist",
    "assets:busytex": "node scripts/fetch-busytex-assets.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "puppeteer-core": "^25.12.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandevdaza/texit.git"
  },
  "homepage": "https://github.com/fernandevdaza/texit",
  "bugs": {
    "url": "https://github.com/fernandevdaza/texit/issues"
  },
  "author": "Fernando Daza (https://github.com/fernandevdaza)",
  "keywords": [
    "latex",
    "tex",
    "overleaf-alternative",
    "pdflatex",
    "xelatex",
    "lualatex",
    "webassembly",
    "collaborative-editing",
    "crdt",
    "yjs",
    "webrtc",
    "local-first",
    "electron",
    "ai",
    "mcp",
    "synctex"
  ]
}
