{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@texit/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "compiler-harness",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@texit/compiler",
        "harness"
      ],
